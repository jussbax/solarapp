# keep the build context small: data, databases, virtualenvs, node modules and git stay out of the image
.git
.github
data/
**/*.db
**/*.db-journal
.env
backend/.venv/
backend/.pytest_cache/
**/__pycache__/
frontend/node_modules/
frontend/dist/
*.log
# the supplier workbook is mounted into the private container, not baked into the image
backend/data_seed/
site/dist/
