# Copy to .env and edit. All variables are read by the backend.
SOLARAPP_APP_USERNAME=admin
SOLARAPP_APP_PASSWORD=change-me
# Long random string used to sign the login cookie, e.g. from: openssl rand -hex 32
SOLARAPP_SECRET_KEY=change-me-to-a-long-random-string
SOLARAPP_COMPANY_NAME=Your Solar Company
SOLARAPP_COMPANY_CONTACT=
