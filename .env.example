# Copy to .env and edit. All variables are read by the backend.
# The first owner's account is created from these two at the first start, and never read again:
# people, passwords, authenticators and keys live in the database (Settings > People, Settings > Your account).
# You may clear the password here once the owner exists.
SOLARAPP_APP_USERNAME=admin
SOLARAPP_APP_PASSWORD=change-me
# Long random string used to sign the login cookie, e.g. from: openssl rand -hex 32.
# Leave it blank and the app generates one once into data/secret.key.
SOLARAPP_SECRET_KEY=
SOLARAPP_COMPANY_NAME=PL Development Inc.
SOLARAPP_COMPANY_CONTACT=Pila, Laguna
# Only with docker-compose.lan.yml: where Docker publishes port 8000 (127.0.0.1 = this machine, 0.0.0.0 = the office network)
SOLARAPP_BIND=127.0.0.1
# Set to false only for plain-http testing on the office network; the login cookie is marked Secure otherwise
SOLARAPP_COOKIE_SECURE=true
# The back office's own hostname (used only by the single-container fallback to tell hostnames apart)
SOLARAPP_OFFICE_HOST=solar.pldevinc.com
# Two-factor login needs no variable: each person sets up their authenticator app and keys under Settings > Your account

# --- Website estimate (optional) ---
# Website origins allowed to embed the estimate widget and call /api/quick/* (comma separated, no trailing slash)
SOLARAPP_PUBLIC_ORIGINS=https://pldevinc.com,https://www.pldevinc.com
# The back office's public address, used in links sent to you (lead emails)
SOLARAPP_PUBLIC_URL=https://solar.pldevinc.com
# The website's address: the card's QR code and the copied estimate summary point at its /estimate page (default: the first origin above)
SOLARAPP_WEBSITE_URL=https://pldevinc.com
# A hostname that serves the estimate page at its root and nothing else; use it before the website exists
SOLARAPP_PUBLIC_HOST=pldevinc.com
# Email notice for every website lead. Leave blank to switch off. Gmail: smtp.gmail.com, port 587, an app password.
SOLARAPP_SMTP_HOST=
SOLARAPP_SMTP_PORT=587
SOLARAPP_SMTP_USER=
SOLARAPP_SMTP_PASSWORD=
SOLARAPP_SMTP_FROM=
SOLARAPP_NOTIFY_EMAIL=

# --- Website and tunnels as containers (recommended) ---
# Shared secret between the public website process and the private app; any long random string:
#   openssl rand -hex 24
SOLARAPP_INTERNAL_TOKEN=
# Tunnel tokens from the Cloudflare Zero Trust dashboard (Networks > Tunnels > Create a tunnel > Docker).
# Office tunnel: public hostname solar.pldevinc.com -> http://solarapp:8000
# Website tunnel: public hostnames pldevinc.com and www.pldevinc.com -> http://solarapp-public:8000
CF_TUNNEL_TOKEN_OFFICE=
CF_TUNNEL_TOKEN_PUBLIC=
# So a plain `docker compose up -d` after maintenance brings the tunnels up too
COMPOSE_PROFILES=tunnels
