# Copy to .env and edit. All variables are read by the backend.
SOLARAPP_APP_USERNAME=admin
SOLARAPP_APP_PASSWORD=change-me
# Long random string used to sign the login cookie, e.g. from: openssl rand -hex 32
SOLARAPP_SECRET_KEY=change-me-to-a-long-random-string
SOLARAPP_COMPANY_NAME=PL Development Inc.
SOLARAPP_COMPANY_CONTACT=Pila, Laguna
# Where Docker publishes port 8000: 127.0.0.1 = this machine only (use the tunnel), 0.0.0.0 = also the local network
SOLARAPP_BIND=127.0.0.1

# --- Website estimate (optional) ---
# Website origins allowed to embed the estimate widget and call /api/quick/* (comma separated, no trailing slash)
SOLARAPP_PUBLIC_ORIGINS=https://pldevinc.com,https://www.pldevinc.com
# The back office's public address, used in links sent to you (lead emails)
SOLARAPP_PUBLIC_URL=https://solar.pldevinc.com
# A hostname that serves the estimate page at its root and nothing else; use it before the website exists
SOLARAPP_PUBLIC_HOST=pldevinc.com
# Email notice for every website lead. Leave blank to switch off. Gmail: smtp.gmail.com, port 587, an app password.
SOLARAPP_SMTP_HOST=
SOLARAPP_SMTP_PORT=587
SOLARAPP_SMTP_USER=
SOLARAPP_SMTP_PASSWORD=
SOLARAPP_SMTP_FROM=
SOLARAPP_NOTIFY_EMAIL=
